<%- include('../include/header', { title: 'إدارة البرامج والمساقات' }) %>

<nav class="teal darken-2">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/admin/dashboard" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
        البرامج الأكاديمية والمقررات الدراسية
      </a>
      <a href="#" class="sidenav-trigger show-on-large" data-target="slide-out"><i class="material-icons">menu</i></a>
    </div>
  </div>
</nav>

<div class="main" style="padding-top: 15px;">
  <div class="card-panel" style="border-radius: 12px;">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="card-panel green lighten-4 green-text text-darken-4 center" style="border-radius: 8px; font-weight: 600;">
        <i class="material-icons tiny right">check_circle</i><%= message %>
      </div>
    <% } %>

    <div class="row valign-wrapper" style="margin-bottom: 10px;">
      <div class="col s8">
        <h5 style="margin: 0; font-weight: 700; color: #004d40;">البرامج والتخصصات المعتمدة</h5>
        <p class="grey-text" style="font-size: 13px; margin: 4px 0 0 0;">قائمة بجميع برامج البكالوريوس والدراسات العليا المتاحة</p>
      </div>
      <div class="col s4 left-align">
        <a href="/admin/addcourse" class="btn teal darken-1 waves-effect waves-light" style="border-radius: 8px; font-weight: 600;">
          <i class="material-icons right">post_add</i>إضافة تخصص جديد
        </a>
      </div>
    </div>

    <div class="card-content" style="margin-top: 15px;">
      <div class="responsive-table" style="overflow-x: auto;">
        <table class="striped highlight">
          <thead>
            <tr class="teal lighten-4">
              <th>م</th>
              <th>رمز / اختصار البرنامج</th>
              <th>اسم البرنامج الكامل</th>
              <th>تاريخ الاعتماد / الإنشاء</th>
              <th>الإجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% if (courses.length === 0) { %>
              <tr>
                <td colspan="5" class="center grey-text" style="padding: 25px;">لا توجد برامج أكاديمية مضافة.</td>
              </tr>
            <% } else { %>
              <% courses.forEach((course, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><span class="chip teal white-text" style="font-weight: 700;"><%= course.course_short_name %></span></td>
                  <td><b style="font-size: 15px;"><%= course.course_full_name %></b></td>
                  <td><%= course.course_date %></td>
                  <td>
                    <a href="/admin/editcourse/<%= course.course_id %>" class="teal-text text-darken-2 waves-effect waves-light" title="تعديل البرنامج" style="margin-left: 15px;">
                      <i class="material-icons">mode_edit</i>
                    </a>
                    <form method="POST" action="/admin/deletecourse" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا البرنامج الأكاديمي؟');">
                      <input type="hidden" name="id" value="<%= course.course_id %>">
                      <button type="submit" class="btn-flat red-text" style="padding: 0; background: none; border: none; cursor: pointer;" title="حذف البرنامج">
                        <i class="material-icons">delete</i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="fixed-action-btn" style="right: auto; left: 23px;">
  <a href="/admin/addcourse" class="btn-floating btn-large pulse teal darken-2">
    <i class="material-icons">add</i>
  </a>
</div>

<%- include('../include/sidenav') %>
<%- include('../include/footer') %>
