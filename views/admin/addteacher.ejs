<%- include('../include/header', { title: 'إضافة عضو هيئة تدريس' }) %>

<nav class="teal darken-2">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/admin/dashboard" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
        إضافة عضو هيئة تدريس جديد
      </a>
      <a href="#" class="sidenav-trigger show-on-large" data-target="slide-out"><i class="material-icons">menu</i></a>
    </div>
  </div>
</nav>

<div class="row main" style="padding-top: 15px;">
  <div class="col l12 m12 s12">
    <form action="/admin/addteacher" method="POST" enctype="multipart/form-data">
      <div class="card-panel" style="border-radius: 12px;">
        <div class="center" style="margin-bottom: 20px;">
          <h5 style="margin-top: 0; font-weight: 700; color: #004d40;">بيانات المعلم / الأستاذ الجامعي</h5>
          <% if (typeof error !== 'undefined' && error) { %>
            <h6 class="center red-text"><b><%= error %></b></h6>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <h6 class="center green-text"><b><%= success %></b></h6>
          <% } %>
        </div>

        <div class="row">
          <div class="col l4 m12 s12 center" style="padding: 20px;">
            <div style="border: 2px dashed #b0bec5; border-radius: 12px; padding: 25px; background: #fafafa;">
              <i class="material-icons large teal-text text-lighten-2">person</i>
              <p style="font-weight: 600; margin-top: 0;">الصورة الشخصية للأستاذ</p>
              <div class="file-field input-field">
                <div class="btn teal btn-small" style="border-radius: 6px;">
                  <span>اختر صورة</span>
                  <input type="file" name="image" accept="image/*">
                </div>
                <div class="file-path-wrapper">
                  <input class="file-path validate" type="text" placeholder="رفع صورة الأستاذ">
                </div>
              </div>
            </div>
          </div>

          <div class="col l4 m6 s12">
            <div class="input-field">
              <i class="material-icons prefix">person</i>
              <input type="text" name="name" id="name" required="required">
              <label for="name">الاسم الكامل (مع اللقب العلمي)</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">email</i>
              <input type="email" name="email" id="email" required="required">
              <label for="email">البريد الإلكتروني الجامعي</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">call</i>
              <input type="text" name="contact" id="contact" required="required">
              <label for="contact">رقم الهاتف / الجوال</label>
            </div>
          </div>

          <div class="col l4 m6 s12">
            <div class="input-field">
              <select name="position" required="required">
                <option value="" disabled selected>اختر المسمى والرتبة الأكاديمية</option>
                <option value="أستاذ دكتور (Professor)">أستاذ دكتور (Professor)</option>
                <option value="أستاذ مشارك (Associate Professor)">أستاذ مشارك (Associate Professor)</option>
                <option value="أستاذ مساعد (Assistant Professor)">أستاذ مساعد (Assistant Professor)</option>
                <option value="محاضر (Lecturer)">محاضر (Lecturer)</option>
                <option value="معيد (Teaching Assistant)">معيد (Teaching Assistant)</option>
                <option value="مدير الشؤون الأكاديمية (Manager)">مدير الشؤون الأكاديمية (Manager)</option>
              </select>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">lock</i>
              <input type="password" name="password" id="password" required="required" minlength="4">
              <label for="password">كلمة المرور الخاصة بالدخول</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">location_city</i>
              <input type="text" name="address" id="address" required="required">
              <label for="address">المكتب / القسم الأكاديمي</label>
            </div>
          </div>

          <div class="col s12 center" style="margin: 15px 0;">
            <label style="margin-left: 25px;">
              <input type="radio" name="gender" value="ذكر" checked />
              <span style="font-size: 15px; font-weight: 600;">ذكر</span>
            </label>
            <label>
              <input type="radio" name="gender" value="أنثى" />
              <span style="font-size: 15px; font-weight: 600;">أنثى</span>
            </label>
          </div>
        </div>

        <div class="center" style="margin-top: 15px;">
          <button type="submit" name="submit" style="width:100%; border-radius: 8px; font-weight: 700; height: 42px;" class="btn teal darken-2 waves-effect waves-light">
            <i class="material-icons right">check</i>حفظ وتسجيل عضو التدريس
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../include/sidenav') %>
<%- include('../include/footer') %>
