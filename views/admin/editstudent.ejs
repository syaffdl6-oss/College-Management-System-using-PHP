<%- include('../include/header', { title: 'تعديل بيانات الطالب' }) %>

<nav class="teal darken-2">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/admin/dashboard" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
        تحديث بيانات الطالب
      </a>
      <a href="#" class="sidenav-trigger show-on-large" data-target="slide-out"><i class="material-icons">menu</i></a>
    </div>
  </div>
</nav>

<div class="row main" style="padding-top: 15px;">
  <div class="col l12 m12 s12">
    <form action="/admin/editstudent/<%= student.id %>" method="POST" enctype="multipart/form-data">
      <div class="card-panel" style="border-radius: 12px;">
        <div class="center" style="margin-bottom: 20px;">
          <h5 style="margin-top: 0; font-weight: 700; color: #004d40;">تعديل ملف الطالب: <%= student.name %></h5>
          <% if (typeof error !== 'undefined' && error) { %>
            <h6 class="center red-text"><b><%= error %></b></h6>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <h6 class="center green-text"><b><%= success %></b></h6>
          <% } %>
        </div>

        <div class="row">
          <div class="col l4 m12 s12 center" style="padding: 20px;">
            <img src="/img/<%= student.image || 'user.png' %>" class="responsive-img circle" style="width: 130px; height: 130px; object-fit: cover; border: 3px solid #009688; margin-bottom: 12px;">
            <p style="font-weight: 600; margin-top: 0;">تغيير الصورة الشخصية</p>
            <div class="file-field input-field">
              <div class="btn teal btn-small" style="border-radius: 6px;">
                <span>اختر ملف</span>
                <input type="file" name="image" accept="image/*">
              </div>
              <div class="file-path-wrapper">
                <input class="file-path validate" type="text" placeholder="تحديث الصورة">
              </div>
            </div>
          </div>

          <div class="col l4 m6 s12">
            <div class="input-field">
              <i class="material-icons prefix">fingerprint</i>
              <input type="text" value="<%= student.rollno %>" name="rollno" id="rollno" required="required">
              <label for="rollno" class="active">رقم القيد / رقم الجلوس</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">person</i>
              <input type="text" value="<%= student.name %>" name="name" id="name" required="required">
              <label for="name" class="active">الاسم الكامل للطالب</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">call</i>
              <input type="text" value="<%= student.contact %>" name="contact" id="contact" required="required">
              <label for="contact" class="active">رقم الهاتف / الجوال</label>
            </div>
          </div>

          <div class="col l4 m6 s12">
            <div class="input-field">
              <select name="standerd" required="required">
                <option value="1" <%= (student.standerd == '1' || student.standerd == 'Btech') ? 'selected' : '' %>>بكالوريوس هندسة الحاسوب والتكنولوجيا (B.Tech)</option>
                <option value="2" <%= (student.standerd == '2' || student.standerd == 'BBA') ? 'selected' : '' %>>بكالوريوس إدارة أعمال (BBA)</option>
                <option value="3" <%= (student.standerd == '3' || student.standerd == 'BCA') ? 'selected' : '' %>>بكالوريوس نظم وتطبيقات الحاسب (BCA)</option>
                <option value="4" <%= (student.standerd == '4' || student.standerd == 'MBA') ? 'selected' : '' %>>ماجستير إدارة الأعمال (MBA)</option>
                <option value="5" <%= (student.standerd == '5' || student.standerd == 'MCA') ? 'selected' : '' %>>ماجستير تطبيقات الحاسوب (MCA)</option>
                <option value="6" <%= (student.standerd == '6' || student.standerd == 'Mtech') ? 'selected' : '' %>>ماجستير تقنية المعلومات (M.Tech)</option>
              </select>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">location_city</i>
              <input type="text" value="<%= student.city %>" name="city" id="city" required="required">
              <label for="city" class="active">المدينة / السكن</label>
            </div>
            <div class="input-field">
              <i class="material-icons prefix">email</i>
              <input type="email" value="<%= student.email %>" name="email" id="email" required="required">
              <label for="email" class="active">البريد الإلكتروني</label>
            </div>
          </div>

          <div class="col s12 center" style="margin: 15px 0;">
            <label style="margin-left: 25px;">
              <input type="radio" name="gender" value="ذكر" <%= (student.gender === 'ذكر' || student.gender === 'male') ? 'checked' : '' %> />
              <span style="font-size: 15px; font-weight: 600;">ذكر</span>
            </label>
            <label>
              <input type="radio" name="gender" value="أنثى" <%= (student.gender === 'أنثى' || student.gender === 'female') ? 'checked' : '' %> />
              <span style="font-size: 15px; font-weight: 600;">أنثى</span>
            </label>
          </div>
        </div>

        <div class="center" style="margin-top: 15px;">
          <button type="submit" name="submit" style="width:100%; border-radius: 8px; font-weight: 700; height: 42px;" class="btn teal darken-2 waves-effect waves-light">
            <i class="material-icons right">save</i>حفظ التعديلات
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../include/sidenav') %>
<%- include('../include/footer') %>
