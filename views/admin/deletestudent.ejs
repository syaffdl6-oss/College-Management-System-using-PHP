<%- include('../include/header', { title: 'البحث عن الطلاب' }) %>

<nav class="teal darken-2">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/admin/dashboard" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
        البحث وفلترة سجلات الطلاب
      </a>
      <a href="#" class="sidenav-trigger show-on-large" data-target="slide-out"><i class="material-icons">menu</i></a>
    </div>
  </div>
</nav>

<div class="row main" style="padding-top: 15px;">
  <div class="col l12 m12 s12">
    <form action="/admin/deletestudent" method="POST">
      <div class="card-panel" style="border-radius: 12px;">
        <div class="row" style="margin-bottom: 0;">
          <div class="col l4 m6 s12">
            <div class="input-field">
              <select name="standerd">
                <option value="">جميع البرامج الأكاديمية</option>
                <option value="1" <%= selectedStanderd === '1' ? 'selected' : '' %>>بكالوريوس هندسة الحاسوب (B.Tech)</option>
                <option value="2" <%= selectedStanderd === '2' ? 'selected' : '' %>>بكالوريوس إدارة أعمال (BBA)</option>
                <option value="3" <%= selectedStanderd === '3' ? 'selected' : '' %>>بكالوريوس نظم وتطبيقات الحاسب (BCA)</option>
                <option value="4" <%= selectedStanderd === '4' ? 'selected' : '' %>>ماجستير إدارة الأعمال (MBA)</option>
                <option value="5" <%= selectedStanderd === '5' ? 'selected' : '' %>>ماجستير تطبيقات الحاسوب (MCA)</option>
                <option value="6" <%= selectedStanderd === '6' ? 'selected' : '' %>>ماجستير تقنية المعلومات (M.Tech)</option>
              </select>
            </div>
          </div>
          <div class="col l5 m6 s12">
            <div class="input-field">
              <i class="material-icons prefix">search</i>
              <input type="text" name="name" id="name" value="<%= searchName || '' %>">
              <label for="name" class="<%= searchName ? 'active' : '' %>">ابحث بالاسم أو جزء من اسم الطالب</label>
            </div>
          </div>
          <div class="col l3 m12 s12 center" style="margin-top: 15px;">
            <button class="btn teal darken-2 waves-effect waves-light" style="width: 100%; border-radius: 8px; font-weight: 700; height: 42px;" name="search">
              <i class="material-icons right">search</i>تنفيذ البحث
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="row main">
  <div class="col l12">
    <div class="card" style="border-radius: 12px; overflow: hidden;">
      <ul class="collection" style="margin: 0; border: none;">
        <li class="collection-item" style="padding: 0;">
          <div class="responsive-table" style="overflow-x: auto;">
            <table class="striped highlight">
              <thead>
                <tr class="teal lighten-4">
                  <th>م</th>
                  <th>صورة الطالب</th>
                  <th>اسم الطالب</th>
                  <th>رقم القيد</th>
                  <th>البرنامج الدراسي</th>
                  <th>الجنس</th>
                  <th>المدينة</th>
                  <th>رقم التواصل</th>
                  <th>الإجراء</th>
                </tr>
              </thead>
              <tbody>
                <% if (results.length === 0) { %>
                  <tr>
                    <td colspan="9" class="center grey-text" style="padding: 25px;">لا توجد نتائج مطابقة لبحثك الحالي.</td>
                  </tr>
                <% } else { %>
                  <% results.forEach((data, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td>
                        <img src="/img/<%= data.image || 'user.png' %>" class="responsive-img circle" style="width: 48px; height: 48px; object-fit: cover;">
                      </td>
                      <td><b><%= data.name %></b></td>
                      <td><span class="chip grey lighten-3 teal-text text-darken-3" style="font-weight: 700;"><%= data.rollno %></span></td>
                      <td><span class="chip teal white-text" style="font-size: 12px;"><%= data.displayStanderd || data.standerd %></span></td>
                      <td><%= data.gender %></td>
                      <td><%= data.city %></td>
                      <td><%= data.contact %></td>
                      <td>
                        <a href="/admin/editstudent/<%= data.id %>" class="btn-small teal waves-effect waves-light" style="border-radius: 6px;">
                          <i class="material-icons right tiny">edit</i>تعديل
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>

<%- include('../include/sidenav') %>
<%- include('../include/footer') %>
