<%- include('../include/header', { title: 'تعديل البرنامج الأكاديمي' }) %>

<nav class="teal darken-2">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/admin/dashboard" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
        تحديث البرنامج الدراسي
      </a>
      <a href="#" class="sidenav-trigger show-on-large" data-target="slide-out"><i class="material-icons">menu</i></a>
    </div>
  </div>
</nav>

<div class="card-panel main" style="border-radius: 12px; margin-top: 15px;">
  <span class="card-title container">
    <h5 style="font-weight: 700; color: #004d40;">تعديل بيانات البرنامج: <%= course.course_short_name %></h5>
    <% if (typeof success !== 'undefined' && success) { %>
      <h6 class="center green-text" style="font-weight: 600;"><b><%= success %></b></h6>
    <% } %>
  </span>
  <form action="/admin/editcourse/<%= course.course_id %>" method="POST">
    <div class="card-content container">
      <div class="input-field">
        <i class="material-icons prefix">school</i>
        <input type="text" name="course_short_name" value="<%= course.course_short_name %>" id="course_short_name" required="required">
        <label for="course_short_name" class="active">رمز أو اختصار التخصص</label>
      </div>
      <div class="input-field">
        <i class="material-icons prefix">book</i>
        <input type="text" name="course_full_name" value="<%= course.course_full_name %>" id="course_full_name" required="required">
        <label for="course_full_name" class="active">الاسم الكامل للتخصص</label>
      </div>
      <div class="input-field">
        <i class="material-icons prefix">today</i>
        <input type="text" name="course_date" id="course_date" value="<%= course.course_date %>" required="required">
        <label for="course_date" class="active">تاريخ الاعتماد</label>
      </div>
      <div class="center" style="margin-top: 25px;">
        <button type="submit" name="update_course" class="btn teal darken-2 waves-effect waves-light" style="width:100%; border-radius: 8px; font-weight: 700; height: 42px;">
          <i class="material-icons right">save</i>حفظ تعديلات البرنامج
        </button>
      </div>
    </div>
  </form>
</div>

<div class="fixed-action-btn" style="right: auto; left: 23px;">
  <a href="/admin/course" class="btn-floating btn-large teal darken-2">
    <i class="material-icons large">arrow_forward</i>
  </a>
</div>

<%- include('../include/sidenav') %>
<%- include('../include/footer') %>
