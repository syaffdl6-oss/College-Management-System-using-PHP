<%- include('../include/students_header') %>
<%- include('../include/students_sidenav') %>

<nav class="brown darken-4">
  <div class="nav-wrapper">
    <a href="/students/index" class="brand-logo center" style="font-size: 20px; font-weight: 700;">
      بوابة الطالب الأكاديمية
    </a>
    <a href="#" class="sidenav-trigger" data-target="slide-out"><i class="material-icons">menu</i></a>
    <a href="#" class="dropdown-trigger left" data-target="dropdown" style="margin-left: 15px;">
      <img src="/img/<%= student.image || 'user.png' %>" class="responsive-img circle" alt="" style="width: 40px; height: 40px; object-fit: cover; margin-top: 12px; border: 2px solid white;">
    </a>
  </div>
</nav>

<div class="row mufazmi" style="padding-top: 20px;">
  <div class="col s12 m12 l3">
    <div class="card-panel z-depth-1" style="padding: 20px; border-radius: 12px;">
      <div class="card-image center">
        <img src="/img/<%= student.image || 'user.png' %>" class="circle responsive-img" style="width: 125px; height: 125px; object-fit: cover; border: 3px solid #795548; box-shadow: 0 4px 10px rgba(0,0,0,0.15);" alt="">
        <h5 class="center" style="margin-top: 12px; font-weight: 700; color: #3e2723;"><%= student.name %></h5>
        <span class="chip brown lighten-4 brown-text text-darken-4" style="font-weight: 600;">طالب مسجل</span>
        <div class="divider" style="margin: 15px 0;"></div>
        <table>
          <tbody>
            <tr>
              <th style="color: #616161;">رقم القيد الأكاديمي:</th>
              <td class="blue-text text-darken-3" style="font-weight: 700;"><%= student.enrollmentNo || '12020002017044' %></td>
            </tr>
            <tr>
              <th style="color: #616161;">البرنامج الدراسي:</th>
              <td class="blue-text text-darken-3"><b><%= student.courseName || 'بكالوريوس علوم الحاسوب' %></b></td>
            </tr>
            <tr>
              <th style="color: #616161;">القسم الأكاديمي:</th>
              <td class="blue-text text-darken-3"><%= student.department || 'قسم تقنية المعلومات' %></td>
            </tr>
            <tr>
              <th style="color: #616161;">رقم الجلوس:</th>
              <td class="blue-text text-darken-3" style="font-weight: 700;"><%= student.rollno %></td>
            </tr>
            <tr>
              <th style="color: #616161;">المرحلة / التخصص:</th>
              <td class="blue-text text-darken-3"><%= student.displayStanderd || student.standerd %></td>
            </tr>
            <tr>
              <th style="color: #616161;">الشعبة / المجموعة:</th>
              <td class="blue-text text-darken-3"><%= student.section || 'أ' %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col s12 m12 l9">
    <div class="card z-depth-1" style="border-radius: 12px; overflow: hidden;">
      <ul class="tabs">
        <li class="tab col s3"><a href="#profile" class="active"><i class="material-icons tiny right" style="vertical-align: middle;">person</i>الملف الشخصي</a></li>
        <li class="tab col s3"><a href="#fees"><i class="material-icons tiny right" style="vertical-align: middle;">payment</i>الرسوم الدراسية</a></li>
        <li class="tab col s3"><a href="#exam"><i class="material-icons tiny right" style="vertical-align: middle;">event</i>جدول الامتحانات</a></li>
        <li class="tab col s3"><a href="#document"><i class="material-icons tiny right" style="vertical-align: middle;">folder</i>الوثائق والشهادات</a></li>
      </ul>

      <div id="profile" class="col s12 white" style="padding: 20px;">
        <div class="card-panel" style="border-radius: 8px; box-shadow: none; border: 1px solid #e0e0e0; margin-bottom: 20px;">
          <h5 style="margin-top: 0; font-weight: 700; color: #3e2723;">المعلومات الأساسية والاتصال</h5>
          <table class="striped">
            <tbody>
              <tr>
                <th style="width: 30%; color: #616161;">تاريخ الميلاد:</th>
                <td><b><%= student.dob || '2001/11/15' %></b></td>
              </tr>
              <tr>
                <th style="color: #616161;">الفئة والصفة:</th>
                <td><%= student.category || 'انتظام كامل' %></td>
              </tr>
              <tr>
                <th style="color: #616161;">رقم الهاتف / الجوال:</th>
                <td><%= student.contact %></td>
              </tr>
              <tr>
                <th style="color: #616161;">البريد الإلكتروني:</th>
                <td><%= student.email %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card-panel" style="border-radius: 8px; box-shadow: none; border: 1px solid #e0e0e0;">
          <h5 style="margin-top: 0; font-weight: 700; color: #3e2723;">بيانات السكن والإقامة</h5>
          <table class="striped">
            <tbody>
              <tr>
                <th style="width: 30%; color: #616161;">العنوان الحالي:</th>
                <td><%= student.currentAddress || 'حي الياسمين، الرياض' %></td>
              </tr>
              <tr>
                <th style="color: #616161;">العنوان الدائم:</th>
                <td><%= student.permanentAddress || 'حي الياسمين، الرياض' %></td>
              </tr>
              <tr>
                <th style="color: #616161;">المدينة:</th>
                <td><%= student.city %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div id="fees" class="col s12 white" style="padding: 30px;">
        <h5 style="font-weight: 700; color: #3e2723;">سجل الرسوم والمصروفات الدراسية</h5>
        <p class="grey-text">كشف بحساب الرسوم الجامعية لكل فصل دراسي وحالة السداد:</p>
        <table class="striped highlight" style="margin-top: 20px;">
          <thead>
            <tr class="brown lighten-5">
              <th>الفصل الدراسي</th>
              <th>المبلغ المستحق</th>
              <th>تاريخ الاستحقاق</th>
              <th>حالة السداد</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>الفصل الدراسي الأول 2024</td>
              <td><b>4,500 ر.س</b></td>
              <td>15 سبتمبر 2024</td>
              <td><span class="chip green white-text" style="font-weight: 600;">تم السداد بالكامل</span></td>
            </tr>
            <tr>
              <td>الفصل الدراسي الثاني 2025</td>
              <td><b>4,500 ر.س</b></td>
              <td>10 يناير 2025</td>
              <td><span class="chip green white-text" style="font-weight: 600;">تم السداد بالكامل</span></td>
            </tr>
            <tr>
              <td>الفصل الدراسي الصيفي 2025</td>
              <td><b>2,000 ر.س</b></td>
              <td>15 يونيو 2025</td>
              <td><span class="chip amber darken-2 white-text" style="font-weight: 600;">مستحق قريباً</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="exam" class="col s12 white" style="padding: 30px;">
        <h5 style="font-weight: 700; color: #3e2723;">جدول الاختبارات والنتائج الأكاديمية</h5>
        <p class="grey-text">جدول مواعيد قاعات الامتحانات النهائية ونتائج المساقات:</p>
        <table class="striped highlight" style="margin-top: 20px;">
          <thead>
            <tr class="brown lighten-5">
              <th>المقرر / المادة</th>
              <th>التاريخ</th>
              <th>الوقت</th>
              <th>القاعة</th>
              <th>النتيجة والتقدير</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>هياكل البيانات والخوارزميات</b></td>
              <td>12 نوفمبر 2024</td>
              <td>10:00 صباحاً</td>
              <td>قاعة المحاضرات ب-201</td>
              <td><span class="chip green white-text" style="font-weight: 700;">ممتاز مرتفع +A (95%)</span></td>
            </tr>
            <tr>
              <td><b>نظم إدارة قواعد البيانات</b></td>
              <td>15 نوفمبر 2024</td>
              <td>01:00 ظهراً</td>
              <td>مختبر الحاسب ج-104</td>
              <td><span class="chip green white-text" style="font-weight: 700;">ممتاز A (90%)</span></td>
            </tr>
            <tr>
              <td><b>شبكات الحاسوب والأمن السيبراني</b></td>
              <td>19 نوفمبر 2024</td>
              <td>10:00 صباحاً</td>
              <td>مدرج الكلية أ-102</td>
              <td><span class="chip green white-text" style="font-weight: 700;">جيد جداً مرتفع +B (87%)</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="document" class="col s12 white" style="padding: 30px;">
        <h5 style="font-weight: 700; color: #3e2723;">الوثائق والشهادات الأكاديمية الرقمية</h5>
        <p class="grey-text">تحميل بطاقة الطالب الجامعية والمستندات المعتمدة بصيغة PDF:</p>
        <div class="collection" style="margin-top: 20px; border-radius: 8px;">
          <a href="#!" class="collection-item black-text">
            <span class="badge blue white-text" style="font-weight: 600;">مفعلة</span>
            <i class="material-icons right teal-text">picture_as_pdf</i>
            بطاقة الطالب الرقمية الجامعية (Digital ID Card)
          </a>
          <a href="#!" class="collection-item black-text">
            <span class="badge green white-text" style="font-weight: 600;">معتمد ومختوم</span>
            <i class="material-icons right teal-text">description</i>
            إفادة إثبات قيد وتسجيل طالب منتظم
          </a>
          <a href="#!" class="collection-item black-text">
            <span class="badge green white-text" style="font-weight: 600;">متاح للتحميل</span>
            <i class="material-icons right teal-text">grade</i>
            كشف الدرجات الأكاديمي للفصول السابقة (Transcript)
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<ul class="dropdown-content" id="dropdown">
  <li><a href="/students/logout" class="black-text"><i class="material-icons right red-text">logout</i>تسجيل الخروج</a></li>
</ul>

<%- include('../include/students_footer') %>
