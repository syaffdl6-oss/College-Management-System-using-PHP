<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title><%= typeof title !== 'undefined' ? title : 'نظام إدارة الكلية الأكاديمي' %></title>
  <!--Import Google Cairo Font for Arabic typography-->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <!--Import Google Icon Font-->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <!--Import materialize.css-->
  <link type="text/css" rel="stylesheet" href="/css/materialize.min.css" media="screen,projection"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <style>
    body {
      font-family: 'Cairo', 'Tajawal', sans-serif !important;
      direction: rtl;
      text-align: right;
    }
    input, select, textarea, button {
      font-family: 'Cairo', 'Tajawal', sans-serif !important;
    }
    .input-field .prefix {
      right: 0.5rem;
      left: auto !important;
    }
    .input-field .prefix ~ input,
    .input-field .prefix ~ label,
    .input-field .prefix ~ select {
      margin-right: 3rem;
      margin-left: 0;
      width: calc(100% - 3rem);
    }
    .input-field label:not(.label-icon).active {
      transform-origin: 100% 0 !important;
    }
    .brand-logo {
      font-weight: 700;
    }
  </style>
</head>
